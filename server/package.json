{
  "name": "impact-trading-server",
  "version": "0.1.0",
  "description": "Backend Node.js della simulazione paper trading 24/7 (su VPS Contabo). Sostituisce il Worker CF.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev":   "node --watch src/index.js",
    "db:init": "node src/db.js --init",
    "logs":  "pm2 logs impact-trading-server"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "bcryptjs":          "^2.4.3",
    "better-sqlite3":    "^11.5.0",
    "dotenv":            "^16.4.5",
    "hono":              "^4.6.10",
    "node-cron":         "^3.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
