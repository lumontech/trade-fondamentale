# Copia in `.env` sul VPS e riempi
# Server
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173,https://impact-trading.pages.dev

# API token: Bearer auth richiesto su tutte le rotte POST
# Generalo con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
API_TOKEN=

# Database (path SQLite)
DB_PATH=./data/impact.db

# TwelveData API keys (rotation)
TWELVEDATA_API_KEY=
TWELVEDATA_API_KEY_2=

# Defaults config simulazione
DEFAULT_BROKER_ID=fpmarkets_raw
DEFAULT_STARTING_BALANCE=1000
DEFAULT_RISK_PCT=1

# Fix #4.2: Adaptive SL/TP. Se "true", il sim ricalcola sl_mul/tp_mul ogni 20
# trade chiusi per account_key in base al win rate (heuristic semplice).
# DEFAULT OFF — abilitare solo dopo testing approfondito.
ADAPTIVE_SLTP_ENABLED=false